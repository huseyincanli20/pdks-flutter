@page
@model AttendanceLogModel
@{
    ViewData["Title"] = "Çalışan Hareketleri (Tüm Kayıtlar)";
}

<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-person-walking-arrow-right text-indigo-600"></i> Çalışan Hareketleri Günlüğü
        </h1>
        <p class="text-sm text-slate-500 mt-1">Personellerin tüm GPS doğrulamalı giriş ve çıkış denemeleri</p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-page="/MobilePunch" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-4 py-2.5 rounded-xl text-sm transition-all shadow-sm">
            <i class="fa-solid fa-mobile-screen-button"></i> Mobil Giriş Ekranı
        </a>
    </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Son 50 Hareket</span>
        <span class="text-xs font-mono text-indigo-600 font-bold">Toplam: @Model.Records.Count Kayıt</span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase border-b border-slate-100 font-semibold">
                <tr>
                    <th class="px-5 py-3.5">Personel</th>
                    <th class="px-5 py-3.5">Hareket Türü</th>
                    <th class="px-5 py-3.5">Tarih & Saat</th>
                    <th class="px-5 py-3.5">GPS Doğrulama</th>
                    <th class="px-5 py-3.5">Mesafe</th>
                    <th class="px-5 py-3.5">Cihaz / Not</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-5 py-8 text-center text-slate-400">Henüz bir hareket kaydı bulunmuyor.</td>
                    </tr>
                }
                @foreach (var record in Model.Records)
                {
                    <tr class="hover:bg-slate-50/70">
                        <td class="px-5 py-3.5">
                            <div class="font-bold text-slate-900">@record.Employee?.FullName</div>
                            <div class="text-xs text-slate-400">@record.Employee?.Department • @record.Employee?.Title</div>
                        </td>
                        <td class="px-5 py-3.5">
                            @if (record.Type == PdksApp.Models.AttendanceType.CheckIn)
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                    <i class="fa-solid fa-arrow-right-to-bracket mr-1"></i> Giriş
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-100">
                                    <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Çıkış
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3.5 font-mono text-xs text-slate-600">
                            @record.Timestamp.AddHours(3).ToString("dd.MM.yyyy HH:mm:ss")
                        </td>
                        <td class="px-5 py-3.5">
                            @if (record.IsLocationVerified)
                            {
                                <span class="text-xs text-emerald-600 font-bold flex items-center gap-1">
                                    <i class="fa-solid fa-circle-check"></i> Onaylandı
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-rose-600 font-bold flex items-center gap-1">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Kapsam Dışı
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3.5 text-xs font-mono font-bold text-slate-600">
                            @record.CalculatedDistanceMeters m
                        </td>
                        <td class="px-5 py-3.5 text-xs text-slate-400 truncate max-w-[200px]" title="@record.Note">
                            @record.Note
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
