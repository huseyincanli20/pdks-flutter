<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Bulut PDKS SaaS</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center gap-3">
                    <div class="bg-indigo-600 text-white p-2 rounded-xl flex items-center justify-center shadow-md shadow-indigo-100">
                        <i class="fa-solid fa-fingerprint text-xl"></i>
                    </div>
                    <div>
                        <span class="font-bold text-lg text-slate-900 tracking-tight flex items-center gap-2">
                            Bulut PDKS
                            <span class="text-xs bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full font-semibold">SaaS</span>
                        </span>
                        <p class="text-xs text-slate-400">GPS & Mobil Personel Takip</p>
                    </div>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <a asp-page="/Index" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-chart-pie mr-1"></i> Panel
                    </a>
                    <a asp-page="/Approvals" class="text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-stamp mr-1"></i> Onaylarım
                    </a>
                    <a asp-page="/AttendanceLog" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-person-walking mr-1"></i> Hareketler
                    </a>
                    <a asp-page="/Overtime" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-clock mr-1"></i> Fazla Mesai
                    </a>
                    <a asp-page="/Leaves" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-calendar-days mr-1"></i> İzinler
                    </a>
                    <a asp-page="/LaborRequest" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-user-plus mr-1"></i> İşçilik Talebi
                    </a>
                    <a asp-page="/Visitors" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-id-badge mr-1"></i> Ziyaretçi
                    </a>
                    <a asp-page="/Payroll" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-file-invoice-dollar mr-1"></i> Bordro
                    </a>
                    <a asp-page="/Puantaj" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-file-excel mr-1"></i> Puantaj
                    </a>
                    <a asp-page="/Surveys" class="text-xs font-semibold text-slate-600 hover:text-indigo-600 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-square-poll-vertical mr-1"></i> Anketler
                    </a>
                    <a asp-page="/Billing" class="text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 px-2.5 py-1.5 rounded-lg transition-colors">
                        <i class="fa-solid fa-credit-card mr-1"></i> Abonelik
                    </a>
                    <a asp-page="/MobilePunch" class="text-xs font-bold bg-indigo-600 text-white hover:bg-indigo-700 px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                        <i class="fa-solid fa-mobile-screen-button mr-1"></i> Mobil GPS
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500">
        <p>&copy; 2026 Bulut PDKS SaaS. 200 TL/Ay - 2.000 TL/Yıl Kampanyalı Kurumsal Sürüm.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
