@page
@model PayrollModel
@{
    ViewData["Title"] = "Bordro ve Maaş İşlemleri";
}

<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-file-invoice-dollar text-emerald-600"></i> Bordro & Maaş Hesaplama İşlemleri
        </h1>
        <p class="text-sm text-slate-500 mt-1">Personel baz maaşları, fazla mesai hak edişleri, kesintiler ve net maaş dökümü</p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-page="/Puantaj" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-4 py-2.5 rounded-xl text-sm transition-all">
            <i class="fa-solid fa-file-excel mr-1"></i> Puantaj Verilerini Gör
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Toplam Net Maaş Yükü</span>
            <div class="text-2xl font-black text-slate-900 mt-1">@Model.TotalNetPayout.ToString("N2") TL</div>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-lg">
            <i class="fa-solid fa-vault"></i>
        </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Toplam Fazla Mesai Ödemesi</span>
            <div class="text-2xl font-black text-amber-600 mt-1">@Model.TotalOvertimePayout.ToString("N2") TL</div>
        </div>
        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-lg">
            <i class="fa-solid fa-money-bill-trend-up"></i>
        </div>
    </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase border-b border-slate-100 font-semibold">
                <tr>
                    <th class="px-5 py-3.5">Personel</th>
                    <th class="px-5 py-3.5">Dönem</th>
                    <th class="px-5 py-3.5">Baz Maaş</th>
                    <th class="px-5 py-3.5">Fazla Mesai Ücreti</th>
                    <th class="px-5 py-3.5">Prim / Ek</th>
                    <th class="px-5 py-3.5">Kesintiler</th>
                    <th class="px-5 py-3.5">Net Maaş</th>
                    <th class="px-5 py-3.5">Ödeme Durumu</th>
                    <th class="px-5 py-3.5 text-right">İşlem</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var p in Model.Records)
                {
                    <tr class="hover:bg-slate-50/70">
                        <td class="px-5 py-3.5">
                            <div class="font-bold text-slate-900">@p.Employee?.FullName</div>
                            <div class="text-xs text-slate-400">@p.Employee?.Department</div>
                        </td>
                        <td class="px-5 py-3.5 text-xs font-mono font-bold text-slate-600">
                            @p.Month / @p.Year
                        </td>
                        <td class="px-5 py-3.5 font-mono text-slate-700 text-xs">
                            @p.BaseSalary.ToString("N2") TL
                        </td>
                        <td class="px-5 py-3.5 font-mono font-bold text-amber-600 text-xs">
                            +@p.OvertimePay.ToString("N2") TL
                            <span class="text-slate-400 font-normal">(@p.TotalOvertimeHours sa)</span>
                        </td>
                        <td class="px-5 py-3.5 font-mono text-emerald-600 text-xs">
                            +@p.Bonus.ToString("N2") TL
                        </td>
                        <td class="px-5 py-3.5 font-mono text-rose-600 text-xs">
                            -@p.Deductions.ToString("N2") TL
                        </td>
                        <td class="px-5 py-3.5 font-mono font-black text-slate-900 text-sm">
                            @p.NetSalary.ToString("N2") TL
                        </td>
                        <td class="px-5 py-3.5">
                            @if (p.IsPaid)
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700">
                                    <i class="fa-solid fa-check mr-1"></i> Ödendi
                                </span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700">
                                    <i class="fa-solid fa-clock mr-1"></i> Bekliyor
                                </span>
                            }
                        </td>
                        <td class="px-5 py-3.5 text-right">
                            @if (!p.IsPaid)
                            {
                                <button onclick="markAsPaid(@p.Id)" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-sm">
                                    Öde
                                </button>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">@p.PaidDate?.ToString("dd.MM.yyyy")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    async function markAsPaid(id) {
        if (!confirm("Bu bordronun ödendiğini onaylıyor musunuz?")) return;
        const res = await fetch(`/api/payroll/pay/${id}`, { method: "POST" });
        if (res.ok) location.reload();
    }
</script>
}
