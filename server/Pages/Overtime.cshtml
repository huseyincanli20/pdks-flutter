@page
@model OvertimeModel
@{
    ViewData["Title"] = "Fazla Mesai Yönetimi";
}

<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-clock-rotate-left text-amber-500"></i> Fazla Mesai Yönetimi
        </h1>
        <p class="text-sm text-slate-500 mt-1">Personel fazla mesai talepleri, saatlik ücret hesaplama ve onay takibi</p>
    </div>
    <div class="flex items-center gap-3">
        <button onclick="openOvertimeModal()" class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-4 py-2.5 rounded-xl text-sm transition-all shadow-sm">
            <i class="fa-solid fa-plus mr-1"></i> Yeni Fazla Mesai Bildir
        </button>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Onay Bekleyen Mesai Süresi</span>
            <div class="text-2xl font-black text-amber-600 mt-1">@Model.TotalPendingHours Saat</div>
        </div>
        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-lg">
            <i class="fa-solid fa-hourglass-start"></i>
        </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Onaylanan Toplam Mesai Hak Edişi</span>
            <div class="text-2xl font-black text-emerald-600 mt-1">@Model.TotalEstimatedPay.ToString("N2") TL</div>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-lg">
            <i class="fa-solid fa-coins"></i>
        </div>
    </div>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase border-b border-slate-100 font-semibold">
                <tr>
                    <th class="px-5 py-3.5">Personel</th>
                    <th class="px-5 py-3.5">Tarih</th>
                    <th class="px-5 py-3.5">Mesai Süresi</th>
                    <th class="px-5 py-3.5">Hesaplanan Tutar</th>
                    <th class="px-5 py-3.5">Açıklama / Sebep</th>
                    <th class="px-5 py-3.5">Durum</th>
                    <th class="px-5 py-3.5 text-right">İşlem</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model.Records)
                {
                    <tr class="hover:bg-slate-50/70">
                        <td class="px-5 py-3.5">
                            <div class="font-bold text-slate-900">@item.Employee?.FullName</div>
                            <div class="text-xs text-slate-400">@item.Employee?.Department</div>
                        </td>
                        <td class="px-5 py-3.5 text-xs font-mono text-slate-600">
                            @item.OvertimeDate.ToString("dd.MM.yyyy")
                        </td>
                        <td class="px-5 py-3.5 font-bold font-mono text-slate-800">
                            @item.Hours Saat
                        </td>
                        <td class="px-5 py-3.5 font-bold font-mono text-emerald-600">
                            @item.EstimatedPay.ToString("N2") TL
                        </td>
                        <td class="px-5 py-3.5 text-xs text-slate-500">
                            @item.Reason
                        </td>
                        <td class="px-5 py-3.5">
                            @if (item.Status == PdksApp.Models.ApprovalStatus.Pending)
                            {
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700">Beklemede</span>
                            }
                            else if (item.Status == PdksApp.Models.ApprovalStatus.Approved)
                            {
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">Onaylandı</span>
                            }
                            else
                            {
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700">Reddedildi</span>
                            }
                        </td>
                        <td class="px-5 py-3.5 text-right">
                            @if (item.Status == PdksApp.Models.ApprovalStatus.Pending)
                            {
                                <div class="inline-flex gap-1.5">
                                    <button onclick="processApproval(2, @item.Id, 1)" class="p-1.5 rounded-lg bg-emerald-50 text-emerald-600 hover:bg-emerald-600 hover:text-white"><i class="fa-solid fa-check text-xs"></i></button>
                                    <button onclick="processApproval(2, @item.Id, 2)" class="p-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-600 hover:text-white"><i class="fa-solid fa-xmark text-xs"></i></button>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">İşlendi</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div id="otModal" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <h3 class="font-bold text-slate-900 text-lg border-b pb-3">Fazla Mesai Bildirimi</h3>
        <div class="space-y-3 text-xs">
            <div>
                <label class="block font-bold text-slate-700 mb-1">Personel</label>
                <select id="otEmp" class="w-full bg-slate-50 border rounded-xl p-2.5">
                    @foreach (var emp in Model.Employees)
                    {
                        <option value="@emp.Id">@emp.FullName (@emp.HourlyRate TL/saat)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">PIN Kodu</label>
                <input type="password" id="otPin" value="1001" class="w-full bg-slate-50 border rounded-xl p-2.5 font-mono" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Tarih</label>
                    <input type="date" id="otDate" class="w-full bg-slate-50 border rounded-xl p-2" />
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Süre (Saat)</label>
                    <input type="number" id="otHours" value="2.5" step="0.5" class="w-full bg-slate-50 border rounded-xl p-2 font-mono" />
                </div>
            </div>
            <div>
                <label class="block font-bold text-slate-700 mb-1">Gerekçe / Proje</label>
                <textarea id="otReason" rows="2" placeholder="Mesai sebebi..." class="w-full bg-slate-50 border rounded-xl p-2.5"></textarea>
            </div>
        </div>
        <div class="pt-2 flex justify-end gap-2">
            <button onclick="document.getElementById('otModal').classList.add('hidden')" class="px-4 py-2 rounded-xl text-slate-600 text-xs font-semibold">İptal</button>
            <button onclick="submitOvertime()" class="px-4 py-2 rounded-xl bg-amber-600 text-white text-xs font-semibold">Talebi Gönder</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openOvertimeModal() {
        document.getElementById("otDate").value = new Date().toISOString().split('T')[0];
        document.getElementById("otModal").classList.remove("hidden");
    }

    async function submitOvertime() {
        const empId = parseInt(document.getElementById("otEmp").value);
        const pin = document.getElementById("otPin").value;
        const date = document.getElementById("otDate").value;
        const hours = parseFloat(document.getElementById("otHours").value);
        const reason = document.getElementById("otReason").value;

        const res = await fetch("/api/overtime/create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ employeeId: empId, pinCode: pin, date: date, hours: hours, reason: reason })
        });
        const data = await res.json();
        if (res.ok && data.success) { alert(data.message); location.reload(); }
        else { alert(data.message || "Hata oluştu."); }
    }

    async function processApproval(type, id, status) {
        const res = await fetch("/api/approvals/process", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ itemType: type, itemId: id, newStatus: status, comment: "Yönetici onayı" })
        });
        if (res.ok) location.reload();
    }
</script>
}
